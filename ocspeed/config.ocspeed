
config ocspeed 'main'
	option enabled '1'
	option interval '30'
	option threshold '50'
	option test_url 'https://www.gstatic.com/generate_204'
	option gemini_url 'https://gemini.google.com'
	option exclude '剩余流量 套餐到期 重置剩余 无法使用 请更换 请升级 直连地址 TG群 邀请 返佣 公告'
	option timeout '4000'
	option sites 'https://www.youtube.com|https://www.netflix.com|https://www.disneyplus.com|https://gemini.google.com|https://chatgpt.com|https://claude.ai'
	option testsites 'https://www.baidu.com|https://www.bilibili.com|https://www.taobao.com|https://www.qq.com|https://www.google.com|https://www.youtube.com|https://www.netflix.com|https://github.com|https://gemini.google.com|https://chatgpt.com|https://claude.ai'
	option failover_enable '0'
	option failover_cooldown '120'
	option failover_threshold '3000'
	option failover_quiet '90'
	option backup_enable '0'
	option backup_interval '90'
	option backup_probe '8'
	option backup_keep '3'
	option group '宝贝云'

